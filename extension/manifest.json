{
  "manifest_version": 3,
  "name": "Cognivue Focus Coach",
  "version": "1.0.0",
  "description": "Universal cognitive focus HUD for work, study, meetings, and browsing.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:5173/*",
    "https://meet.google.com/*",
    "https://docs.google.com/*",
    "https://github.com/*",
    "https://stackoverflow.com/*",
    "https://*.zoom.us/*",
    "https://*.teams.microsoft.com/*",
    "https://*.notion.so/*",
    "https://*.medium.com/*",
    "https://*.arxiv.org/*",
    "https://*.codeforces.com/*",
    "https://*.leetcode.com/*",
    "https://*.coursera.org/*",
    "https://*.udemy.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cognivue Focus HUD"
  }
}
